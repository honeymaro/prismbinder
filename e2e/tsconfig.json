{
  // The e2e suite was outside every include list, so `pnpm typecheck` gave no
  // signal on it at all - Playwright transpiles with esbuild and never checks
  // types. A deliberate type error here used to pass CI.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
