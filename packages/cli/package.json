{
  "name": "@prismbinder/cli",
  "version": "0.0.0",
  "description": "Command line tools for GraphPad Prism files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeymaro/prismbinder.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/honeymaro/prismbinder#readme",
  "bugs": {
    "url": "https://github.com/honeymaro/prismbinder/issues"
  },
  "keywords": [
    "graphpad",
    "prism",
    "prismbinder",
    "cli",
    "pzfx",
    "convert"
  ],
  "type": "module",
  "bin": {
    "prismbinder": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@prismbinder/core": "workspace:^",
    "@prismbinder/formats": "workspace:^",
    "@prismbinder/model": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  }
}
