{
  "name": "prismbinder-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm -r --stream build",
    "clean": "tsc -b --clean && rimraf packages/*/dist",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p e2e/tsconfig.json && pnpm --filter @prismbinder/editor typecheck",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "test:e2e": "pnpm --filter @prismbinder/editor build && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "pako": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@prismbinder/formats": "workspace:^"
  },
  "dependencies": {
    "jsonc-parser": "catalog:"
  }
}
